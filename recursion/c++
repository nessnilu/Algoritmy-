#include <iostream>
using namespace std;

double power(double x, int n) {
    if (n == 0) return 1; 
    if (n < 0) return 1 / power(x, -n);  
    return x * power(x, n - 1);  
}

int main() {
    cout << power(2, 3) << endl;    
    cout << power(5, 0) << endl;    
    cout << power(2, -2) << endl;   
    return 0;
}

//вывод
//8
//1
//0.25
